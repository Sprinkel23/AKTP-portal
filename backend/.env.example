# AKTP PORTAL - Backend Environment Variables
DATABASE_URL=postgresql+psycopg2://postgres:aktp_postgres_pass@localhost:5433/aktp_portal
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-site.netlify.app

# MSG91 SMS Gateway (Optional - runs in clearly labelled Demonstration Mode if unset)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AKTUIT
MSG91_TEMPLATE_ID=

# WhatsApp Business Cloud API (Optional - runs in clearly labelled Demonstration Mode if unset)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
